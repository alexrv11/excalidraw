# Build any local-dev binary.
# Usage (from repo root):
#   docker build --build-arg CMD_NAME=api-local -f backend/Dockerfile.local -t api-local backend/
#   docker build --build-arg CMD_NAME=ws-local  -f backend/Dockerfile.local -t ws-local  backend/
ARG CMD_NAME=api-local

FROM golang:1.21-alpine AS builder
ARG CMD_NAME
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/server ./cmd/${CMD_NAME}

FROM alpine:3.19
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/server /server
EXPOSE 8787 8788
CMD ["/server"]
