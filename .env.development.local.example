# Copy this to .env.development.local to point the Vite dev server
# at the local Docker Compose stack instead of the production AWS API.
#
#   cp .env.development.local.example .env.development.local
#   pnpm seed:libraries
#   docker compose -f docker-compose.local.yml up --build

# Local HTTP API (api service → :8787)
VITE_APP_AWS_API_URL=http://localhost:8787
VITE_APP_BACKEND_V2_GET_URL=http://localhost:8787/api/v2/
VITE_APP_BACKEND_V2_POST_URL=http://localhost:8787/api/v2/post/

# Local WebSocket (ws service → :8788)
VITE_APP_WS_SERVER_URL=ws://localhost:8788

# Library page assets served by the Vite dev server itself (already default)
VITE_APP_LIBRARY_URL=http://localhost:3001/libraries
